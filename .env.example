# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/applications_db

# Anthropic API key (получите в https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-api-key-here

# Auth secret (сгенерируйте через: openssl rand -base64 32)
AUTH_SECRET=change-this-to-a-random-secret-for-production
AUTH_TRUST_HOST=true
